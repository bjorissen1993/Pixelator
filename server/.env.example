# Generation provider. auto | pixellab | local | fallback
# auto: PixelLab if PIXELLAB_API_KEY is set, else PIXELATOR_MODEL_ID if it is not SDXL-Turbo.
PIXELATOR_PROVIDER=auto

# Local Diffusers checkpoint or Hub id. Do not default to SDXL-Turbo.
PIXELATOR_MODEL_ID=
PIXELATOR_LORA=
PIXELATOR_DEVICE=cuda
PIXELATOR_DTYPE=

# Opt-in only. The old photographic 512px Turbo path is not the default engine.
PIXELATOR_ALLOW_TURBO_FALLBACK=false

# Legacy aliases (optional)
MODEL_ID=
PIXEL_MODEL_ID=
LORA_PATH=
LORA_STRENGTH=0.8
CONTROLNET_MODEL=
IP_ADAPTER_MODEL=
DEVICE=cuda
DTYPE=

ENABLE_BG_REMOVAL=false
WORKING_SIZE=48
INFERENCE_STEPS=12
GUIDANCE_SCALE=3.5
CANDIDATE_COUNT=2

PIXELLAB_API_KEY=
PIXELLAB_API_BASE=https://api.pixellab.ai/v2
